{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["bom1"],
  "functions": {
    "backend/app.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/certs/supabase-ca.crt,frontend/dist/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
